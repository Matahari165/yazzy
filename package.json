{
  "name": "yazzy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:multi": "npx -y concurrently -n next,party -c blue,magenta \"next dev\" \"partykit dev src/party/index.ts\"",
    "party": "partykit dev src/party/index.ts",
    "party:deploy": "partykit deploy src/party/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.3.0",
    "partysocket": "^1.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "partykit": "^0.0.115",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.16.0"
}
